\set ON_ERROR_STOP on
-- Run with client current directory set to data/staging. HEADER MATCH validates names/order.
\copy erp.months (month_id, year, quarter, month_number, days_in_month) FROM 'months.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.production_lines (line_id, line_name, monthly_capacity_units, support_labor_hours_per_month, base_energy_kwh_per_month) FROM 'production_lines.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.materials (material_id, material_name, unit, base_unit_cost_eur) FROM 'materials.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.suppliers (supplier_id, supplier_name, lead_time_days, on_time_delivery_target) FROM 'suppliers.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.customers (customer_id, customer_name, segment) FROM 'customers.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.products (product_id, product_name, category, line_id, base_selling_price_eur, standard_labor_hours_per_attempt, standard_energy_kwh_per_attempt) FROM 'products.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.material_suppliers (material_id, supplier_id) FROM 'material_suppliers.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.bom (product_id, material_id, quantity_kg_per_unit) FROM 'bom.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.line_month_capacity (month_id, line_id, nominal_capacity_units, downtime_pct, effective_capacity_units) FROM 'line_month_capacity.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.production (production_id, month_id, product_id, attempted_units, defective_units, good_units) FROM 'production.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.purchase_order_lines (po_line_id, material_id, supplier_id, order_date, expected_receipt_date, ordered_kg, agreed_unit_cost_eur) FROM 'purchase_order_lines.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.material_receipts (receipt_id, po_line_id, receipt_date, received_kg, landed_unit_cost_eur, receipt_value_eur, purchase_unit_cost_eur, purchase_value_eur, inbound_freight_rate_eur_per_kg, inbound_freight_eur, landed_receipt_value_eur) FROM 'material_receipts.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.material_consumption (production_id, material_id, required_kg, extra_waste_kg, consumed_kg, issued_material_value_eur, weighted_average_unit_cost_eur, issued_purchase_material_value_eur, issued_inbound_freight_eur, weighted_average_purchase_unit_cost_eur, weighted_average_inbound_freight_unit_cost_eur) FROM 'material_consumption.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.raw_material_inventory (month_id, material_id, opening_kg, received_kg, consumed_kg, closing_kg, opening_value_eur, receipt_value_eur, issued_material_value_eur, closing_value_eur, weighted_average_unit_cost_eur, opening_purchase_material_value_eur, opening_inbound_freight_value_eur, receipt_purchase_material_value_eur, receipt_inbound_freight_value_eur, issued_purchase_material_value_eur, issued_inbound_freight_value_eur, closing_purchase_material_value_eur, closing_inbound_freight_value_eur, landed_receipt_value_eur, weighted_average_purchase_unit_cost_eur, weighted_average_inbound_freight_unit_cost_eur) FROM 'raw_material_inventory.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.manufacturing_costs (month_id, line_id, attempted_units, labor_hours, hourly_rate_eur, energy_kwh, energy_tariff_eur, labor_cost_eur, energy_cost_eur, manufacturing_overhead_eur, total_conversion_cost_eur, idle_cost_eur, production_labor_hours, support_labor_hours, activity_energy_kwh, base_energy_kwh, production_labor_cost_eur, support_labor_cost_eur, activity_energy_cost_eur, standby_energy_cost_eur, idle_labor_cost_eur, idle_energy_cost_eur, idle_overhead_cost_eur) FROM 'manufacturing_costs.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.production_cost_allocation (production_id, month_id, product_id, line_id, attempted_units, good_units, material_cost_eur, labor_cost_eur, energy_cost_eur, manufacturing_overhead_eur, total_manufacturing_cost_eur, capitalized_production_cost_eur, production_loss_expense_eur, good_unit_manufacturing_cost_eur, production_labor_cost_eur, support_labor_cost_eur, activity_energy_cost_eur, standby_energy_cost_eur, purchase_material_cost_eur, inbound_freight_cost_eur, capitalized_material_cost_eur, capitalized_inbound_freight_cost_eur, capitalized_labor_cost_eur, capitalized_energy_cost_eur, capitalized_overhead_cost_eur, material_production_loss_expense_eur, inbound_freight_production_loss_expense_eur, labor_production_loss_expense_eur, energy_production_loss_expense_eur, overhead_production_loss_expense_eur) FROM 'production_cost_allocation.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.finished_goods_inventory (month_id, product_id, opening_units, good_production_units, demand_units, shipped_units, unfulfilled_units, closing_units, opening_value_eur, production_value_eur, cogs_eur, closing_value_eur, weighted_average_unit_cost_eur, opening_material_value_eur, opening_inbound_freight_value_eur, opening_labor_value_eur, opening_energy_value_eur, opening_overhead_value_eur, production_material_value_eur, production_inbound_freight_value_eur, production_labor_value_eur, production_energy_value_eur, production_overhead_value_eur, closing_material_value_eur, closing_inbound_freight_value_eur, closing_labor_value_eur, closing_energy_value_eur, closing_overhead_value_eur, material_cogs_eur, inbound_freight_cogs_eur, labor_cogs_eur, energy_cogs_eur, overhead_cogs_eur) FROM 'finished_goods_inventory.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.sales (sales_line_id, month_id, shipment_date, product_id, customer_id, requested_units, unfulfilled_units, units_shipped, list_unit_price_eur, discount_pct, gross_revenue_eur, discount_amount_eur, net_revenue_eur, weighted_average_unit_cost_eur, cogs_eur, material_cogs_eur, inbound_freight_cogs_eur, labor_cogs_eur, energy_cogs_eur, overhead_cogs_eur, outbound_freight_rate_eur_per_unit, outbound_freight_eur) FROM 'sales.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
\copy erp.operating_expenses (month_id, expense_category, amount_eur, fixed_amount_eur, variable_rate_pct, variable_driver_amount_eur, variable_amount_eur) FROM 'operating_expenses.csv' WITH (FORMAT csv, HEADER MATCH, ENCODING 'UTF8');
