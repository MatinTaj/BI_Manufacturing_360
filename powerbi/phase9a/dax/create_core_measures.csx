// Optional Tabular Editor Advanced Scripting: NEW model only, after importing tables.
// Not compiled or executed during Phase 9A; use manual Desktop formulas if this tool is unavailable.
var target = Model.Tables["FactSales"];
var definitions = new [] {
    new [] { "Complete Month Context", "VAR VisibleDays = COUNTROWS(VALUES('DimDate'[Date]))\nVAR ExpectedDays = SUMX(VALUES('DimDate'[MonthStart]), DAY(EOMONTH('DimDate'[MonthStart], 0)))\nRETURN VisibleDays > 0 && VisibleDays = ExpectedDays", "General", "00 Controls", "True only when the selected calendar context contains every day in each visible month." },
    new [] { "Company Context Valid", "[Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimLine') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier'))", "General", "00 Controls", "Company-only financial scope; prevents presenting shared costs as allocated segment profit." },
    new [] { "Net Revenue", "IF([Complete Month Context], SUM('FactSales'[net_revenue_eur]))", "#,0.00", "01 Sales", "Net sales revenue after discounts." },
    new [] { "Gross Sales", "IF([Complete Month Context], SUM('FactSales'[gross_revenue_eur]))", "#,0.00", "01 Sales", "Sales before discounts." },
    new [] { "Sales Discounts", "IF([Complete Month Context], SUM('FactSales'[discount_amount_eur]))", "#,0.00", "01 Sales", "Discount deductions; positive values." },
    new [] { "Shipped Units", "IF([Complete Month Context], SUM('FactSales'[units_shipped]))", "#,0", "01 Sales", "Actual shipped volume." },
    new [] { "Requested Units", "IF([Complete Month Context], SUM('FactSales'[requested_units]))", "#,0", "01 Sales", "Requested demand." },
    new [] { "Unfulfilled Units", "IF([Complete Month Context], SUM('FactSales'[unfulfilled_units]))", "#,0", "01 Sales", "Requested units not shipped." },
    new [] { "Net Realized Price", "DIVIDE([Net Revenue], [Shipped Units])", "#,0.00", "01 Sales", "Weighted realized selling price after discounts." },
    new [] { "Revenue Prior Year", "CALCULATE([Net Revenue], DATEADD('DimDate'[Date], -1, YEAR))", "#,0.00", "01 Sales", "Revenue in the corresponding prior calendar period." },
    new [] { "Revenue YoY %", "DIVIDE([Net Revenue] - [Revenue Prior Year], [Revenue Prior Year])", "0.00%", "01 Sales", "Relative revenue growth; fraction formatted as percent." },
    new [] { "Revenue YTD", "TOTALYTD([Net Revenue], 'DimDate'[Date])", "#,0.00", "01 Sales", "Calendar-year running revenue." },
    new [] { "Material COGS", "IF([Complete Month Context], SUM('FactSales'[material_cogs_eur]))", "#,0.00", "02 Profitability", "Recognized sales COGS component; purchase-material COGS excludes inbound freight." },
    new [] { "Inbound Freight COGS", "IF([Complete Month Context], SUM('FactSales'[inbound_freight_cogs_eur]))", "#,0.00", "02 Profitability", "Recognized sales COGS component; purchase-material COGS excludes inbound freight." },
    new [] { "Labor COGS", "IF([Complete Month Context], SUM('FactSales'[labor_cogs_eur]))", "#,0.00", "02 Profitability", "Recognized sales COGS component; purchase-material COGS excludes inbound freight." },
    new [] { "Energy COGS", "IF([Complete Month Context], SUM('FactSales'[energy_cogs_eur]))", "#,0.00", "02 Profitability", "Recognized sales COGS component; purchase-material COGS excludes inbound freight." },
    new [] { "Overhead COGS", "IF([Complete Month Context], SUM('FactSales'[overhead_cogs_eur]))", "#,0.00", "02 Profitability", "Recognized sales COGS component; purchase-material COGS excludes inbound freight." },
    new [] { "Manufacturing COGS", "IF([Complete Month Context] && COUNTROWS('FactSales') > 0, [Material COGS] + [Inbound Freight COGS] + [Labor COGS] + [Energy COGS] + [Overhead COGS])", "#,0.00", "02 Profitability", "Sum of five authoritative COGS components." },
    new [] { "COGS per Shipped Unit", "DIVIDE([Manufacturing COGS], [Shipped Units])", "#,0.00", "02 Profitability", "Weighted recognized inventory cost per shipped unit." },
    new [] { "Gross Profit", "[Net Revenue] - [Manufacturing COGS]", "#,0.00", "02 Profitability", "Revenue less manufacturing COGS." },
    new [] { "Gross Margin %", "DIVIDE([Gross Profit], [Net Revenue])", "0.00%", "02 Profitability", "Manufacturing gross profit divided by net revenue." },
    new [] { "Outbound Freight", "IF([Complete Month Context], SUM('FactSales'[outbound_freight_eur]))", "#,0.00", "09 Logistics", "Shipment distribution expense below gross profit." },
    new [] { "Contribution after Outbound", "[Gross Profit] - [Outbound Freight]", "#,0.00", "02 Profitability", "Product/customer contribution before shared company costs." },
    new [] { "Contribution Margin %", "DIVIDE([Contribution after Outbound], [Net Revenue])", "0.00%", "02 Profitability", "Contribution after outbound freight divided by revenue." },
    new [] { "Product Gross Profit Rank", "IF(HASONEVALUE('DimProduct'[product_id]), RANKX(ALLSELECTED('DimProduct'), [Gross Profit], , DESC, DENSE))", "#,0", "02 Profitability", "Dense gross profit rank within externally selected product cohort." },
    new [] { "Selling Expenses", "IF([Company Context Valid], CALCULATE(SUM('FactOpex'[amount_eur]), 'FactOpex'[expense_category] = \"selling\"))", "#,0.00", "03 Company P&L", "Approved company operating expense category." },
    new [] { "Administrative Expenses", "IF([Company Context Valid], CALCULATE(SUM('FactOpex'[amount_eur]), 'FactOpex'[expense_category] = \"administration\"))", "#,0.00", "03 Company P&L", "Approved company operating expense category." },
    new [] { "Fixed Selling Expenses", "IF([Company Context Valid], CALCULATE(SUM('FactOpex'[fixed_amount_eur]), 'FactOpex'[expense_category] = \"selling\"))", "#,0.00", "03 Company P&L", "Fixed selling expense resource baseline." },
    new [] { "Variable Selling Expenses", "IF([Company Context Valid], CALCULATE(SUM('FactOpex'[variable_amount_eur]), 'FactOpex'[expense_category] = \"selling\"))", "#,0.00", "03 Company P&L", "Revenue-variable selling expense." },
    new [] { "Idle Production Costs", "IF([Company Context Valid], SUM('FactConversion'[idle_cost_eur]))", "#,0.00", "03 Company P&L", "Separately expensed idle line pools." },
    new [] { "Abnormal Production Losses", "IF([Complete Month Context], SUM('FactManufacturing'[production_loss_expense_eur]))", "#,0.00", "03 Company P&L", "Fully defective batch costs, separately expensed." },
    new [] { "Separately Expensed Production Costs", "IF([Company Context Valid], [Idle Production Costs] + [Abnormal Production Losses])", "#,0.00", "03 Company P&L", "Idle line costs plus fully defective production losses, once." },
    new [] { "Operating Profit", "IF([Company Context Valid], [Gross Profit] - [Outbound Freight] - [Selling Expenses] - [Administrative Expenses] - [Separately Expensed Production Costs])", "#,0.00", "03 Company P&L", "Approved company operating profit." },
    new [] { "Operating Margin %", "DIVIDE([Operating Profit], IF([Company Context Valid], [Net Revenue]))", "0.00%", "03 Company P&L", "Company operating profit as a share of revenue." },
    new [] { "Operating Profit Prior Year", "CALCULATE([Operating Profit], DATEADD('DimDate'[Date], -1, YEAR))", "#,0.00", "03 Company P&L", "Comparable prior-year company operating profit." },
    new [] { "Operating Profit YoY %", "DIVIDE([Operating Profit] - [Operating Profit Prior Year], [Operating Profit Prior Year])", "0.00%", "03 Company P&L", "Relative operating profit growth." },
    new [] { "Operating Margin Change pp", "VAR Prior = CALCULATE([Operating Margin %], DATEADD('DimDate'[Date], -1, YEAR))\nRETURN IF(NOT ISBLANK(Prior) && NOT ISBLANK([Operating Margin %]), 100 * ([Operating Margin %] - Prior))", "0.00 \"pp\"", "03 Company P&L", "Change in operating margin in percentage points." },
    new [] { "Operating Profit YTD", "TOTALYTD([Operating Profit], 'DimDate'[Date])", "#,0.00", "03 Company P&L", "Calendar-year company operating profit running total." },
    new [] { "Attempted Units", "IF([Complete Month Context], SUM('FactProduction'[attempted_units]))", "#,0", "04 Production", "Production volume; defects included in attempted units." },
    new [] { "Good Units", "IF([Complete Month Context], SUM('FactProduction'[good_units]))", "#,0", "04 Production", "Production volume; defects included in attempted units." },
    new [] { "Defective Units", "IF([Complete Month Context], SUM('FactProduction'[defective_units]))", "#,0", "04 Production", "Production volume; defects included in attempted units." },
    new [] { "Effective Capacity Units", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), SUM('FactCapacity'[effective_capacity_units]))", "#,0", "04 Production", "Line/month available capacity, not repeated by product." },
    new [] { "Capacity Utilization %", "DIVIDE([Attempted Units], [Effective Capacity Units])", "0.00%", "04 Production", "Attempted units / effective line capacity; not OEE." },
    new [] { "Defect Rate %", "DIVIDE([Defective Units], [Attempted Units])", "0.00%", "04 Production", "Ratio of total defects to attempted volume." },
    new [] { "Good Yield %", "DIVIDE([Good Units], [Attempted Units])", "0.00%", "04 Production", "Good output / attempted output." },
    new [] { "Purchase Material Manufacturing Cost", "IF([Complete Month Context], SUM('FactManufacturing'[purchase_material_cost_eur]))", "#,0.00", "05 Manufacturing", "Production cost allocation component or capitalized aggregate; never add pools again." },
    new [] { "Inbound Manufacturing Cost", "IF([Complete Month Context], SUM('FactManufacturing'[inbound_freight_cost_eur]))", "#,0.00", "05 Manufacturing", "Production cost allocation component or capitalized aggregate; never add pools again." },
    new [] { "Manufacturing Labor Cost", "IF([Complete Month Context], SUM('FactManufacturing'[labor_cost_eur]))", "#,0.00", "05 Manufacturing", "Production cost allocation component or capitalized aggregate; never add pools again." },
    new [] { "Manufacturing Energy Cost", "IF([Complete Month Context], SUM('FactManufacturing'[energy_cost_eur]))", "#,0.00", "05 Manufacturing", "Production cost allocation component or capitalized aggregate; never add pools again." },
    new [] { "Manufacturing Overhead Cost", "IF([Complete Month Context], SUM('FactManufacturing'[manufacturing_overhead_eur]))", "#,0.00", "05 Manufacturing", "Production cost allocation component or capitalized aggregate; never add pools again." },
    new [] { "Capitalized Production Cost", "IF([Complete Month Context], SUM('FactManufacturing'[capitalized_production_cost_eur]))", "#,0.00", "05 Manufacturing", "Production cost allocation component or capitalized aggregate; never add pools again." },
    new [] { "Total Manufacturing Cost", "[Purchase Material Manufacturing Cost] + [Inbound Manufacturing Cost] + [Manufacturing Labor Cost] + [Manufacturing Energy Cost] + [Manufacturing Overhead Cost]", "#,0.00", "05 Manufacturing", "Five-component production cost incurred." },
    new [] { "Material Manufacturing Share %", "DIVIDE([Purchase Material Manufacturing Cost], [Total Manufacturing Cost])", "0.00%", "05 Manufacturing", "Component share of production cost, not sales COGS." },
    new [] { "Inbound Manufacturing Share %", "DIVIDE([Inbound Manufacturing Cost], [Total Manufacturing Cost])", "0.00%", "05 Manufacturing", "Component share of production cost, not sales COGS." },
    new [] { "Labor Manufacturing Share %", "DIVIDE([Manufacturing Labor Cost], [Total Manufacturing Cost])", "0.00%", "05 Manufacturing", "Component share of production cost, not sales COGS." },
    new [] { "Energy Manufacturing Share %", "DIVIDE([Manufacturing Energy Cost], [Total Manufacturing Cost])", "0.00%", "05 Manufacturing", "Component share of production cost, not sales COGS." },
    new [] { "Overhead Manufacturing Share %", "DIVIDE([Manufacturing Overhead Cost], [Total Manufacturing Cost])", "0.00%", "05 Manufacturing", "Component share of production cost, not sales COGS." },
    new [] { "Pool Labor Cost", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), SUM('FactConversion'[labor_cost_eur]))", "#,0.00", "05 Manufacturing", "Line-level cost pool activity; independent from product allocation facts." },
    new [] { "Pool Energy Cost", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), SUM('FactConversion'[energy_cost_eur]))", "#,0.00", "05 Manufacturing", "Line-level cost pool activity; independent from product allocation facts." },
    new [] { "Labor Hours", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), SUM('FactConversion'[labor_hours]))", "#,0.00", "05 Manufacturing", "Line-level cost pool activity; independent from product allocation facts." },
    new [] { "Activity Labor Hours", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), SUM('FactConversion'[production_labor_hours]))", "#,0.00", "05 Manufacturing", "Line-level cost pool activity; independent from product allocation facts." },
    new [] { "Support Labor Hours", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), SUM('FactConversion'[support_labor_hours]))", "#,0.00", "05 Manufacturing", "Line-level cost pool activity; independent from product allocation facts." },
    new [] { "Energy kWh", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), SUM('FactConversion'[energy_kwh]))", "#,0.00", "05 Manufacturing", "Line-level cost pool activity; independent from product allocation facts." },
    new [] { "Activity Energy kWh", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), SUM('FactConversion'[activity_energy_kwh]))", "#,0.00", "05 Manufacturing", "Line-level cost pool activity; independent from product allocation facts." },
    new [] { "Standby Energy kWh", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), SUM('FactConversion'[base_energy_kwh]))", "#,0.00", "05 Manufacturing", "Line-level cost pool activity; independent from product allocation facts." },
    new [] { "Realized Labor Rate", "DIVIDE([Pool Labor Cost], [Labor Hours])", "0.0000", "05 Manufacturing", "Pool labor cost per total activity/support hour." },
    new [] { "Realized Energy Tariff", "DIVIDE([Pool Energy Cost], [Energy kWh])", "0.0000", "05 Manufacturing", "Pool energy cost per total activity/standby kWh." },
    new [] { "Activity Labor per Attempt", "DIVIDE([Activity Labor Hours], [Attempted Units])", "0.0000", "05 Manufacturing", "Line mix-weighted standard production hours per attempt." },
    new [] { "Activity Energy per Attempt", "DIVIDE([Activity Energy kWh], [Attempted Units])", "0.0000", "05 Manufacturing", "Line mix-weighted standard activity kWh per attempt." },
    new [] { "Purchase Spend", "IF([Complete Month Context], SUM('FactReceipts'[purchase_value_eur]))", "#,0.00", "06 Procurement", "Receipt purchase-only value." },
    new [] { "Inbound Receipt Freight", "IF([Complete Month Context], SUM('FactReceipts'[inbound_freight_eur]))", "#,0.00", "06 Procurement", "Capitalized inbound freight on receipts." },
    new [] { "Landed Receipt Value", "IF([Complete Month Context], SUM('FactReceipts'[landed_receipt_value_eur]))", "#,0.00", "06 Procurement", "Purchase plus inbound freight, not another additive expense." },
    new [] { "Received kg", "IF([Complete Month Context], SUM('FactReceipts'[received_kg]))", "#,0.000", "06 Procurement", "Receipt weight." },
    new [] { "Receipt Count", "IF([Complete Month Context], COUNTROWS('FactReceipts'))", "#,0", "06 Procurement", "Count of observed receipt rows." },
    new [] { "On Time Receipts", "IF([Complete Month Context], CALCULATE(COUNTROWS('FactReceipts'), 'FactReceipts'[on_time] = TRUE()))", "#,0", "06 Procurement", "Receipts on or before expected receipt date." },
    new [] { "Receipt OTD %", "DIVIDE([On Time Receipts], [Receipt Count])", "0.00%", "06 Procurement", "Receipt-count on-time ratio, BLANK without receipts." },
    new [] { "Supplier Target OTD %", "DIVIDE(SUMX(VALUES('DimSupplier'[supplier_id]), [Receipt Count] * CALCULATE(MAX('DimSupplier'[on_time_delivery_target]))), [Receipt Count])", "0.00%", "06 Procurement", "Receipt-weighted supplier target fraction; supports aggregated suppliers." },
    new [] { "Supplier Target Gap pp", "IF(NOT ISBLANK([Receipt OTD %]), 100 * ([Receipt OTD %] - [Supplier Target OTD %]))", "0.00 \"pp\"", "06 Procurement", "Observed receipt OTD minus weighted target in percentage points." },
    new [] { "Mean Lead Days", "IF([Complete Month Context], AVERAGE('FactReceipts'[actual_lead_time_days]))", "0.00", "06 Procurement", "Receipt-count weighted mean calendar lead days." },
    new [] { "Mean Late Days", "IF([Complete Month Context], AVERAGEX('FactReceipts', MAX(0, DATEDIFF('FactReceipts'[expected_receipt_date], 'FactReceipts'[receipt_date], DAY))))", "0.00", "06 Procurement", "Mean nonnegative receipt lateness, calendar days." },
    new [] { "Weighted Purchase Price", "DIVIDE([Purchase Spend], [Received kg])", "0.0000", "06 Procurement", "Purchase-only EUR per received kg." },
    new [] { "Weighted Landed Price", "DIVIDE([Landed Receipt Value], [Received kg])", "0.0000", "06 Procurement", "Landed EUR per received kg." },
    new [] { "Supplier Spend Share %", "DIVIDE([Purchase Spend], CALCULATE([Purchase Spend], REMOVEFILTERS('DimSupplier')))", "0.00%", "06 Procurement", "Supplier purchase share of the full supplier population; retains material/date context." },
    new [] { "Ordered kg", "IF([Complete Month Context], SUM('FactPurchaseOrders'[ordered_kg]))", "#,0.000", "06 Procurement", "Ordered quantity attributed to order month." },
    new [] { "Outstanding Ordered kg", "IF([Complete Month Context], SUM('FactPurchaseOrders'[outstanding_kg]))", "#,0.000", "06 Procurement", "Current imported order-line residual, not historical order backlog." },
    new [] { "Raw Closing Inventory", "VAR PeriodMonth = MAX('DimDate'[MonthStart])\nRETURN IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimLine') || ISCROSSFILTERED('DimSupplier')), CALCULATE(SUM('FactRawInventory'[closing_value_eur]), REMOVEFILTERS('DimDate'), TREATAS({PeriodMonth}, 'FactRawInventory'[month_id])))", "#,0.00", "07 Inventory", "Inventory at the selected last closing / first opening month, not sum of snapshots." },
    new [] { "Raw Opening Inventory", "VAR PeriodMonth = MIN('DimDate'[MonthStart])\nRETURN IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimLine') || ISCROSSFILTERED('DimSupplier')), CALCULATE(SUM('FactRawInventory'[opening_value_eur]), REMOVEFILTERS('DimDate'), TREATAS({PeriodMonth}, 'FactRawInventory'[month_id])))", "#,0.00", "07 Inventory", "Inventory at the selected last closing / first opening month, not sum of snapshots." },
    new [] { "Average Raw Inventory", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimLine') || ISCROSSFILTERED('DimSupplier')), AVERAGEX(VALUES('DimDate'[MonthStart]), VAR ThisMonth = 'DimDate'[MonthStart] RETURN CALCULATE(DIVIDE(SUM('FactRawInventory'[opening_value_eur]) + SUM('FactRawInventory'[closing_value_eur]), 2), REMOVEFILTERS('DimDate'), TREATAS({ThisMonth}, 'FactRawInventory'[month_id]))))", "#,0.00", "07 Inventory", "Mean of monthly opening/closing midpoint inventory, at selected entity grain." },
    new [] { "FG Closing Inventory", "VAR PeriodMonth = MAX('DimDate'[MonthStart])\nRETURN IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), CALCULATE(SUM('FactFGInventory'[closing_value_eur]), REMOVEFILTERS('DimDate'), TREATAS({PeriodMonth}, 'FactFGInventory'[month_id])))", "#,0.00", "07 Inventory", "Inventory at the selected last closing / first opening month, not sum of snapshots." },
    new [] { "FG Opening Inventory", "VAR PeriodMonth = MIN('DimDate'[MonthStart])\nRETURN IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), CALCULATE(SUM('FactFGInventory'[opening_value_eur]), REMOVEFILTERS('DimDate'), TREATAS({PeriodMonth}, 'FactFGInventory'[month_id])))", "#,0.00", "07 Inventory", "Inventory at the selected last closing / first opening month, not sum of snapshots." },
    new [] { "Average FG Inventory", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), AVERAGEX(VALUES('DimDate'[MonthStart]), VAR ThisMonth = 'DimDate'[MonthStart] RETURN CALCULATE(DIVIDE(SUM('FactFGInventory'[opening_value_eur]) + SUM('FactFGInventory'[closing_value_eur]), 2), REMOVEFILTERS('DimDate'), TREATAS({ThisMonth}, 'FactFGInventory'[month_id]))))", "#,0.00", "07 Inventory", "Mean of monthly opening/closing midpoint inventory, at selected entity grain." },
    new [] { "Landed Raw Issues", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimLine') || ISCROSSFILTERED('DimSupplier')), SUM('FactRawInventory'[issued_material_value_eur]))", "#,0.00", "07 Inventory", "Raw-material issues at landed cost." },
    new [] { "Inventory COGS", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), SUM('FactFGInventory'[cogs_eur]))", "#,0.00", "07 Inventory", "Finished-goods monthly COGS for inventory ratios." },
    new [] { "FG Turnover", "IF(HASONEVALUE('DimDate'[Year]) && COUNTROWS(VALUES('DimDate'[MonthStart])) = 12, DIVIDE([Inventory COGS], [Average FG Inventory]))", "0.00 \"x\"", "07 Inventory", "Annual FG COGS divided by mean monthly midpoint FG." },
    new [] { "Raw Turnover", "IF(HASONEVALUE('DimDate'[Year]) && COUNTROWS(VALUES('DimDate'[MonthStart])) = 12, DIVIDE([Landed Raw Issues], [Average Raw Inventory]))", "0.00 \"x\"", "07 Inventory", "Annual landed raw issues divided by mean raw inventory." },
    new [] { "Combined Closing Inventory", "IF([Company Context Valid], [Raw Closing Inventory] + [FG Closing Inventory])", "#,0.00", "07 Inventory", "Raw plus FG month-end stock; no WIP." },
    new [] { "Combined Average Inventory", "IF([Company Context Valid], [Average Raw Inventory] + [Average FG Inventory])", "#,0.00", "07 Inventory", "Company average raw plus FG inventory." },
    new [] { "Combined Inventory Turnover", "IF([Company Context Valid] && HASONEVALUE('DimDate'[Year]) && COUNTROWS(VALUES('DimDate'[MonthStart])) = 12, DIVIDE([Manufacturing COGS], [Combined Average Inventory]))", "0.00 \"x\"", "07 Inventory", "Annual COGS / mean combined inventory." },
    new [] { "Selected Calendar Days", "IF([Complete Month Context], COUNTROWS(VALUES('DimDate'[Date])))", "#,0", "07 Inventory", "Actual days in the selected month periods (366 in 2024)." },
    new [] { "Inventory Days Proxy", "IF([Company Context Valid] && HASONEVALUE('DimDate'[Year]) && COUNTROWS(VALUES('DimDate'[MonthStart])) = 12, DIVIDE([Selected Calendar Days] * [Combined Average Inventory], [Manufacturing COGS]))", "#,0.00", "07 Inventory", "Calendar-day inventory proxy; not cash conversion cycle." },
    new [] { "Closing Inventory Change", "VAR Prior = CALCULATE([Combined Closing Inventory], DATEADD('DimDate'[Date], -1, MONTH))\nRETURN IF(HASONEVALUE('DimDate'[YearMonth]) && NOT ISBLANK(Prior), [Combined Closing Inventory] - Prior)", "#,0.00", "07 Inventory", "Change between selected monthly close and prior month close." },
    new [] { "Customer Revenue Share %", "DIVIDE([Net Revenue], CALCULATE([Net Revenue], ALLSELECTED('DimCustomer')))", "0.00%", "08 Customers", "Revenue share within externally selected customer cohort." },
    new [] { "Top 1 Customer Share %", "VAR Customers = ADDCOLUMNS(ALLSELECTED('DimCustomer'), \"__Revenue\", CALCULATE([Net Revenue]))\nVAR TopCustomers = TOPN(1, Customers, [__Revenue], DESC, 'DimCustomer'[customer_id], ASC)\nRETURN DIVIDE(SUMX(TopCustomers, [__Revenue]), SUMX(Customers, [__Revenue]))", "0.00%", "08 Customers", "Top-N share of selected customer revenue; deterministic customer ID ties." },
    new [] { "Top 5 Customer Share %", "VAR Customers = ADDCOLUMNS(ALLSELECTED('DimCustomer'), \"__Revenue\", CALCULATE([Net Revenue]))\nVAR TopCustomers = TOPN(5, Customers, [__Revenue], DESC, 'DimCustomer'[customer_id], ASC)\nRETURN DIVIDE(SUMX(TopCustomers, [__Revenue]), SUMX(Customers, [__Revenue]))", "0.00%", "08 Customers", "Top-N share of selected customer revenue; deterministic customer ID ties." },
    new [] { "Top 10 Customer Share %", "VAR Customers = ADDCOLUMNS(ALLSELECTED('DimCustomer'), \"__Revenue\", CALCULATE([Net Revenue]))\nVAR TopCustomers = TOPN(10, Customers, [__Revenue], DESC, 'DimCustomer'[customer_id], ASC)\nRETURN DIVIDE(SUMX(TopCustomers, [__Revenue]), SUMX(Customers, [__Revenue]))", "0.00%", "08 Customers", "Top-N share of selected customer revenue; deterministic customer ID ties." },
    new [] { "Customer HHI", "VAR Customers = ADDCOLUMNS(ALLSELECTED('DimCustomer'), \"__Revenue\", CALCULATE([Net Revenue]))\nVAR TotalRevenue = SUMX(Customers, [__Revenue])\nRETURN IF(TotalRevenue > 0, SUMX(Customers, POWER(100 * DIVIDE([__Revenue], TotalRevenue), 2)))", "0.00", "08 Customers", "Sum of squared customer percentage shares, 0\u201310000 scale." },
    new [] { "Active Customers", "IF([Complete Month Context], COUNTROWS(FILTER(VALUES('DimCustomer'[customer_id]), [Net Revenue] > 0)))", "#,0", "08 Customers", "Customers with positive recognized net revenue." },
    new [] { "Outbound per Shipped Unit", "DIVIDE([Outbound Freight], [Shipped Units])", "0.0000", "09 Logistics", "Weighted outbound distribution EUR/unit." },
    new [] { "Outbound Revenue Burden %", "DIVIDE([Outbound Freight], [Net Revenue])", "0.00%", "09 Logistics", "Outbound freight expense as share of net revenue." },
    new [] { "Raw Freight Inventory Change", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimProduct') || ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimLine') || ISCROSSFILTERED('DimSupplier')), SUMX('FactRawInventory', 'FactRawInventory'[closing_inbound_freight_value_eur] - 'FactRawInventory'[opening_inbound_freight_value_eur]))", "#,0.00", "09 Logistics", "Net inbound-freight inventory movement across selected complete months." },
    new [] { "FG Freight Inventory Change", "IF([Complete Month Context] && NOT(ISCROSSFILTERED('DimCustomer') || ISCROSSFILTERED('DimMaterial') || ISCROSSFILTERED('DimSupplier')), SUMX('FactFGInventory', 'FactFGInventory'[closing_inbound_freight_value_eur] - 'FactFGInventory'[opening_inbound_freight_value_eur]))", "#,0.00", "09 Logistics", "Net inbound-freight inventory movement across selected complete months." },
    new [] { "Inbound Abnormal Loss", "IF([Complete Month Context], SUM('FactManufacturing'[inbound_freight_production_loss_expense_eur]))", "#,0.00", "09 Logistics", "Inbound component expensed on fully defective batches." },
    new [] { "Inbound Freight Bridge Difference", "IF([Company Context Valid], [Inbound Receipt Freight] - [Inbound Freight COGS] - [Raw Freight Inventory Change] - [FG Freight Inventory Change] - [Inbound Abnormal Loss])", "#,0.00", "09 Logistics", "Inbound receipt cost reconciles to COGS, stock changes and separately expensed losses." },
    new [] { "Daily Shipment Revenue", "CALCULATE(SUM('FactSales'[net_revenue_eur]), USERELATIONSHIP('DimDate'[Date], 'FactSales'[shipment_date]))", "#,0.00", "10 Daily Roles", "Revenue attributed to actual shipment day, not monthly accounting date." },
    new [] { "Daily Received kg", "CALCULATE(SUM('FactReceipts'[received_kg]), USERELATIONSHIP('DimDate'[Date], 'FactReceipts'[receipt_date]))", "#,0.000", "10 Daily Roles", "Receipt kg by actual day." },
    new [] { "Daily Ordered kg", "CALCULATE(SUM('FactPurchaseOrders'[ordered_kg]), USERELATIONSHIP('DimDate'[Date], 'FactPurchaseOrders'[order_date]))", "#,0.000", "10 Daily Roles", "Ordered kg by order day." },
    new [] { "Expected Receipt kg", "CALCULATE(SUM('FactPurchaseOrders'[ordered_kg]), USERELATIONSHIP('DimDate'[Date], 'FactPurchaseOrders'[expected_receipt_date]))", "#,0.000", "10 Daily Roles", "Original ordered kg by expected receipt date; not actual delivery or open backlog." },
    new [] { "COGS Component Difference", "IF([Complete Month Context], SUM('FactSales'[cogs_eur]) - [Manufacturing COGS])", "#,0.00", "11 Validation", "Imported aggregate COGS less five authoritative components." },
    new [] { "Monthly PnL Revenue Difference", "IF([Company Context Valid], [Net Revenue] - CALCULATE(SUM('RefMonthlyPnL'[revenue]), TREATAS(VALUES('DimDate'[MonthStart]), 'RefMonthlyPnL'[month_id])))", "#,0.00", "11 Validation", "Derived revenue less disconnected SQL monthly reference." },
    new [] { "Monthly PnL OP Difference", "IF([Company Context Valid], [Operating Profit] - CALCULATE(SUM('RefMonthlyPnL'[operating_profit]), TREATAS(VALUES('DimDate'[MonthStart]), 'RefMonthlyPnL'[month_id])))", "#,0.00", "11 Validation", "Derived OP less disconnected SQL monthly reference." },
};
foreach(var d in definitions) { if(Model.AllMeasures.Any(m => m.Name == d[0])) throw new System.Exception("Existing measure: " + d[0]); }
foreach(var d in definitions) { var m = target.AddMeasure(d[0], d[1], d[3]); m.FormatString = d[2]; m.Description = d[4]; }
